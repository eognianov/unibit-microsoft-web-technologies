@model FootballTeamsManager.Models.Team

<div class="text-center">
    <h1>Welcome</h1>
    <div class="card shadow-sm" style="max-width: 300px;">
        <img src="@Model.LogoUrl" class="card-img-top p-3" alt="@Model.Name logo" style="height: 160px; object-fit: contain;">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text text-muted mb-1">
                <i class="bi bi-geo-alt"></i> @Model.City
            </p>
            <p class="card-text text-muted">
                <i class="bi bi-calendar"></i> Founded @Model.Founded
            </p>
        </div>
    </div>
</div>

